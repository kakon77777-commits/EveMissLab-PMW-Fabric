{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/pmw-federated-event-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "event_kind", "subject_ref", "realm_ref", "replica_ref", "replica_seq", "causal_parents", "claimed_actor_ref", "claimed_instance_ref", "authority_ref", "payload_ref", "payload_sha256", "payload_media_type", "created_time_ref", "temporal_evidence_status", "local_recorded_at", "correction_of", "withdraws", "not_claimed"],
  "properties": {
    "schema": {"const": "pmw-federated-event/v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_kind": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "realm_ref": {"$ref": "#/$defs/realm"},
    "replica_ref": {"$ref": "#/$defs/replica"},
    "replica_seq": {"type": "integer", "minimum": 1},
    "causal_parents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claimed_actor_ref": {"type": ["string", "null"]},
    "claimed_instance_ref": {"type": ["string", "null"]},
    "authority_ref": {"type": ["string", "null"]},
    "payload_ref": {"type": "string", "pattern": "^payloads/[^.\\\\][^\\\\]*$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "payload_media_type": {"enum": ["application/json", "text/markdown", "text/plain"]},
    "created_time_ref": {"type": ["string", "null"]},
    "temporal_evidence_status": {"enum": ["registered_anchor", "unavailable", "unmeasured"]},
    "local_recorded_at": {"type": "string", "minLength": 1},
    "correction_of": {"type": ["string", "null"]},
    "withdraws": {"type": ["string", "null"]},
    "not_claimed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "realm": {"type": "object", "additionalProperties": false, "required": ["realm_id", "realm_kind", "issuer", "verification_status", "evidence_refs"], "properties": {"realm_id": {"type": "string", "minLength": 1}, "realm_kind": {"enum": ["windows_host", "cloud_host", "hdus_host", "embodied_host", "fixture"]}, "issuer": {"type": "string", "minLength": 1}, "verification_status": {"enum": ["verified", "observed", "claimed", "unmeasured", "rejected"]}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "replica": {"type": "object", "additionalProperties": false, "required": ["replica_id", "realm_id", "store_generation", "verification_status", "evidence_refs"], "properties": {"replica_id": {"type": "string", "minLength": 1}, "realm_id": {"type": "string", "minLength": 1}, "store_generation": {"type": "string", "minLength": 1}, "verification_status": {"enum": ["verified", "observed", "claimed", "unmeasured", "rejected"]}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
