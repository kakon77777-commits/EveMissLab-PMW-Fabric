{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/pmw/receiver-adoption-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "event_id", "event_digest", "receiver_realm_id", "source_schema_id", "source_schema_sha256", "source_ledger_head", "source_view_digest", "decision", "reason_codes", "receiver_observation_refs", "authority_verification_status", "not_claimed", "receipt_digest"],
  "properties": {
    "schema": {"const": "pmw.receiver-adoption-receipt/v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_digest": {"type": "string", "pattern": "^sha256:pmw-federated-event-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "receiver_realm_id": {"type": "string", "minLength": 1},
    "source_schema_id": {"type": "string", "format": "uri"},
    "source_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ledger_head": {"type": "string", "pattern": "^sha256:sedb-ral-chain-v1:[0-9a-f]{64}$"},
    "source_view_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "decision": {"enum": ["adopted", "rejected", "conflict", "quarantined", "pending_dependencies", "unmeasured"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receiver_observation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_verification_status": {"enum": ["not_required", "verified", "rejected", "unmeasured"]},
    "not_claimed": {"const": ["ral_head_mutated", "registry_commit", "authority_granted", "resident_identity_continuity", "source_history_rewritten"]},
    "receipt_digest": {"type": "string", "pattern": "^sha256:pmw-receiver-adoption-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
