{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/arcp/grant-authority-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant_authority_evidence_id", "grantor_party_ref", "authority_source_ref", "resolver_profile_id", "permitted_lifecycle_actions", "permitted_contract_scope", "valid_from", "expires_at", "dependency_refs", "content_digest"],
  "properties": {
    "schema": {"const": "arcp/grant-authority-evidence/0.1"},
    "grant_authority_evidence_id": {"type": "string", "minLength": 1},
    "grantor_party_ref": {"type": "string", "minLength": 1},
    "authority_source_ref": {"type": "string", "minLength": 1},
    "resolver_profile_id": {"type": "string", "minLength": 1},
    "permitted_lifecycle_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "permitted_contract_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "valid_from": {"$ref": "#/$defs/instant"},
    "expires_at": {"$ref": "#/$defs/instant"},
    "dependency_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:arcp-relation-contract-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "instant": {
      "type": "object", "additionalProperties": false,
      "required": ["instant_ref", "clock_profile_id", "normalized_unix_ns", "uncertainty_ns", "verification_status", "source_evidence_refs"],
      "properties": {
        "instant_ref": {"type": "string", "minLength": 1}, "clock_profile_id": {"type": "string", "minLength": 1},
        "normalized_unix_ns": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$"}, "uncertainty_ns": {"type": "integer", "minimum": 0},
        "verification_status": {"enum": ["verified", "observed", "unmeasured", "rejected"]},
        "source_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
