{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/arcp/authority-evaluation-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_ref", "candidate_digest", "evaluator_profile_id", "evaluator_implementation_version", "evaluator_policy_version", "evaluated_evidence_set_digest", "authority_resolution", "evaluated_at", "receipt_digest"],
  "properties": {
    "schema": {"const": "arcp/authority-evaluation-receipt/0.1"},
    "candidate_ref": {"type": "string", "minLength": 1},
    "candidate_digest": {"$ref": "#/$defs/profileDigest"},
    "evaluator_profile_id": {"type": "string", "minLength": 1},
    "evaluator_implementation_version": {"type": "string", "minLength": 1},
    "evaluator_policy_version": {"type": "string", "minLength": 1},
    "evaluated_evidence_set_digest": {"$ref": "#/$defs/profileDigest"},
    "authority_resolution": {"$ref": "#/$defs/resolution"},
    "evaluated_at": {"$ref": "#/$defs/instant"},
    "receipt_digest": {"$ref": "#/$defs/profileDigest"}
  },
  "$defs": {
    "anyDigest": {"type": "string", "pattern": "^sha256:(?:[a-z0-9-]+:)?[0-9a-f]{64}$"},
    "profileDigest": {"type": "string", "pattern": "^sha256:arcp-relation-contract-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "instant": {"type": "object", "additionalProperties": false, "required": ["instant_ref", "clock_profile_id", "normalized_unix_ns", "uncertainty_ns", "verification_status", "source_evidence_refs"], "properties": {"instant_ref": {"type": "string", "minLength": 1}, "clock_profile_id": {"type": "string", "minLength": 1}, "normalized_unix_ns": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$"}, "uncertainty_ns": {"type": "integer", "minimum": 0}, "verification_status": {"enum": ["verified", "observed", "unmeasured", "rejected"]}, "source_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "resolution_id", "run_id", "action_id", "action_hash", "status", "sources", "subject_entity_ref", "resource_scope", "relation_refs", "contract_refs", "revocable", "expires_at", "continuity_precondition"],
      "properties": {
        "schema": {"const": "arcp/authority-resolution/0.1"}, "resolution_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}, "action_id": {"type": "string", "minLength": 1}, "action_hash": {"$ref": "#/$defs/anyDigest"},
        "status": {"enum": ["authorized", "approval-required", "multi-party-required", "denied"]},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "subject_entity_ref": {"type": "string", "minLength": 1},
        "resource_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "relation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contract_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "revocable": {"type": "boolean"}, "expires_at": {"$ref": "#/$defs/instant"},
        "continuity_precondition": {"enum": ["none", "verified-replica", "checkpoint", "migration", "separate-governance"]}
      }
    }
  }
}
