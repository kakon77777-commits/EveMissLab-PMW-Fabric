{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/arcp/commitment-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "commitment_id", "version", "parent_version_digest", "contract_ref", "contract_digest", "obligated_party_ref", "beneficiary_party_refs", "action_class", "scope", "due_or_review_at", "status", "execution_refs", "content_digest"],
  "properties": {
    "schema": {"const": "arcp/commitment/0.1"},
    "commitment_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "parent_version_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "contract_ref": {"type": "string", "minLength": 1},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "obligated_party_ref": {"type": "string", "minLength": 1},
    "beneficiary_party_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "action_class": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "due_or_review_at": {"$ref": "#/$defs/instant"},
    "status": {"enum": ["planned", "active", "satisfied", "breached", "waived", "terminated"]},
    "execution_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:arcp-relation-contract-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "instant": {"type": "object", "additionalProperties": false, "required": ["instant_ref", "clock_profile_id", "normalized_unix_ns", "uncertainty_ns", "verification_status", "source_evidence_refs"], "properties": {"instant_ref": {"type": "string", "minLength": 1}, "clock_profile_id": {"type": "string", "minLength": 1}, "normalized_unix_ns": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$"}, "uncertainty_ns": {"type": "integer", "minimum": 0}, "verification_status": {"enum": ["verified", "observed", "unmeasured", "rejected"]}, "source_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
