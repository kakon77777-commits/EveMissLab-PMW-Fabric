{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/arcp/contract-version-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "version", "parent_version_digest", "relation_version_ref", "relation_version_digest", "party_terms", "scope", "commitment_specs", "authority_candidate_specs", "constraints", "risk_ceiling", "activation_policy_ref", "activation_policy_digest", "approval_mode", "effective_not_before", "expires_at", "review_at", "revocable", "redelegable", "termination_terms", "exit_paths", "survival_clauses", "succession_policy", "residence_impact", "continuity_impact", "continuity_precondition", "economic_terms_ref", "content_digest"],
  "properties": {
    "schema": {"const": "arcp/contract-version/0.1"},
    "contract_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "parent_version_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "relation_version_ref": {"type": ["string", "null"]},
    "relation_version_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "party_terms": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/partyTerm"}},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "commitment_specs": {"type": "array", "items": {"type": "object"}},
    "authority_candidate_specs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidateSpec"}},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk_ceiling": {"enum": ["R0", "R1"]},
    "activation_policy_ref": {"type": "string", "minLength": 1},
    "activation_policy_digest": {"$ref": "#/$defs/digest"},
    "approval_mode": {"const": "all-named-parties"},
    "effective_not_before": {"$ref": "#/$defs/instant"},
    "expires_at": {"$ref": "#/$defs/instant"},
    "review_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/instant"}]},
    "revocable": {"const": true},
    "redelegable": {"const": false},
    "termination_terms": {"$ref": "#/$defs/termination"},
    "exit_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exitPath"}},
    "survival_clauses": {"type": "array", "items": {"$ref": "#/$defs/survival"}},
    "succession_policy": {"const": "explicit_acceptance_only"},
    "residence_impact": {"const": "none"},
    "continuity_impact": {"const": "none"},
    "continuity_precondition": {"const": "none"},
    "economic_terms_ref": {"type": "null"},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:arcp-relation-contract-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "instant": {
      "type": "object", "additionalProperties": false,
      "required": ["instant_ref", "clock_profile_id", "normalized_unix_ns", "uncertainty_ns", "verification_status", "source_evidence_refs"],
      "properties": {
        "instant_ref": {"type": "string", "minLength": 1}, "clock_profile_id": {"type": "string", "minLength": 1},
        "normalized_unix_ns": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$"}, "uncertainty_ns": {"type": "integer", "minimum": 0},
        "verification_status": {"enum": ["verified", "observed", "unmeasured", "rejected"]},
        "source_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "partyTerm": {
      "type": "object", "additionalProperties": false,
      "required": ["party_ref", "role", "acceptance_required", "standing_entity", "representation_scope"],
      "properties": {
        "party_ref": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1},
        "acceptance_required": {"type": "boolean"}, "standing_entity": {"type": "boolean"},
        "representation_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "candidateSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_entity_ref", "requested_resource_scope", "requested_action_scope", "risk"],
      "properties": {
        "subject_entity_ref": {"type": "string", "minLength": 1},
        "requested_resource_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requested_action_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "risk": {"enum": ["R0", "R1"]}
      }
    },
    "exitPath": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "exit_path_id", "authorized_party_refs", "trigger_kind", "unilateral_allowed", "notice_duration_ms", "max_effective_delay_ms", "required_evidence_refs", "effects", "future_candidate_invalidation", "content_digest"],
      "properties": {
        "schema": {"const": "arcp/exit-path/0.1"}, "exit_path_id": {"type": "string", "minLength": 1},
        "authorized_party_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "trigger_kind": {"enum": ["unilateral_notice", "mutual_acceptance", "breach", "expiry", "policy_event"]},
        "unilateral_allowed": {"type": "boolean"}, "notice_duration_ms": {"type": "integer", "minimum": 0},
        "max_effective_delay_ms": {"type": "integer", "minimum": 0},
        "required_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effects": {"enum": ["terminate_contract", "suspend_contract", "withdraw_acceptance"]},
        "future_candidate_invalidation": {"const": "immediate"}, "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "survival": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "survival_clause_id", "class", "scope", "effective_after_termination", "expires_at", "future_authority", "content_digest"],
      "properties": {
        "schema": {"const": "arcp/survival-clause/0.1"}, "survival_clause_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["audit_retention", "attribution", "confidentiality", "non_repudiation"]},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effective_after_termination": {"const": true}, "expires_at": {"type": ["object", "null"]},
        "future_authority": {"const": false}, "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "termination": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "terminal_event_kinds", "terminal_precedence", "candidate_invalidation", "preserve_audit_history", "commitment_disposition", "allowed_survival_clause_refs", "content_digest"],
      "properties": {
        "schema": {"const": "arcp/termination-terms/0.1"}, "terminal_event_kinds": {"const": ["contract.expired", "contract.terminated"]},
        "terminal_precedence": {"const": true}, "candidate_invalidation": {"const": "immediate"}, "preserve_audit_history": {"const": true},
        "commitment_disposition": {"enum": ["terminate", "preserve_named_survival_clauses"]},
        "allowed_survival_clause_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
