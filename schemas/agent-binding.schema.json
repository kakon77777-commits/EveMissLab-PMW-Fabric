{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/pmw/agent-binding-v0.1.schema.json",
  "title": "PMW Agent Binding v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semanticAgentId",
    "kind",
    "bindings"
  ],
  "properties": {
    "semanticAgentId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "human",
        "ai",
        "system"
      ]
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ]
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "bindingType",
          "providerResourceId",
          "verified"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "bindingType": {
            "type": "string"
          },
          "providerResourceId": {
            "type": "string"
          },
          "nativeSessionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
